rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // Public test connection doc
    match /test/{docId} {
      allow read, write: if true;
    }

    // Users collection: players can read profiles; owners or authenticated players can write
    match /users/{userId} {
      allow read: if true;
      allow create: if true;
      allow update: if isAuthenticated() || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['coins', 'rank']);
      allow delete: if false;
    }

    // Orders: players can create their orders; public can read their own or read for billing lookup; staff can update status
    match /orders/{orderId} {
      allow read: if true;
      allow create: if request.resource.data.minecraftUsername is string
                    && request.resource.data.total is number;
      allow update: if true;
      allow delete: if false;
    }

    // Global server config & vitals
    match /config/{configId} {
      allow read: if true;
      allow write: if true;
    }

    // Audit logs: readable by public/staff, append-only
    match /auditLogs/{logId} {
      allow read: if true;
      allow create: if request.resource.data.staffName is string;
      allow update, delete: if false;
    }
  }
}
