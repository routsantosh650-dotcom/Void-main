{
  "entities": {
    "UserAccount": {
      "title": "UserAccount",
      "description": "Registered player or staff account for VOIDMC",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Unique user identifier" },
        "username": { "type": "string", "description": "Minecraft gamer tag" },
        "email": { "type": "string", "description": "Optional email" },
        "role": { "type": "string", "enum": ["player", "staff", "admin"] },
        "rank": { "type": "string", "description": "Server rank designation" },
        "coins": { "type": "number", "description": "Void Coins balance" },
        "avatarUrl": { "type": "string", "description": "Skin head avatar URL" },
        "createdAt": { "type": "string", "description": "Account registration timestamp" }
      },
      "required": ["uid", "username", "role", "coins"]
    },
    "Order": {
      "title": "Order",
      "description": "Store purchase order and billing record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "invoiceNumber": { "type": "string" },
        "minecraftUsername": { "type": "string" },
        "status": { "type": "string", "enum": ["PENDING_VERIFICATION", "COMPLETED", "FAILED"] },
        "subtotal": { "type": "number" },
        "discount": { "type": "number" },
        "total": { "type": "number" },
        "currency": { "type": "string", "enum": ["INR", "USD"] },
        "createdAt": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "utrNumber": { "type": "string" }
      },
      "required": ["id", "invoiceNumber", "minecraftUsername", "status", "total", "currency"]
    },
    "ServerConfig": {
      "title": "ServerConfig",
      "description": "Network status and configuration parameters",
      "type": "object",
      "properties": {
        "onlinePlayers": { "type": "number" },
        "maxPlayers": { "type": "number" },
        "ip": { "type": "string" },
        "port": { "type": "number" },
        "announcementBanner": { "type": "string" },
        "doubleCoinsEvent": { "type": "boolean" },
        "motd": { "type": "string" }
      },
      "required": ["onlinePlayers", "maxPlayers", "ip", "port"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Staff administrative actions and audit history",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "timestamp": { "type": "string" },
        "staffName": { "type": "string" },
        "action": { "type": "string" },
        "details": { "type": "string" },
        "category": { "type": "string" }
      },
      "required": ["id", "timestamp", "staffName", "action"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserAccount",
      "description": "Player and staff profile documents"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Store invoices and payment records"
    },
    "/config/server": {
      "schema": "ServerConfig",
      "description": "Global server configuration parameters"
    },
    "/auditLogs/{logId}": {
      "schema": "AuditLog",
      "description": "Administrative audit trial records"
    }
  }
}
