{
  // Cloudflare Workers config for the VOIDMC site.
  // Committing this file stops `npx wrangler deploy` from running its interactive
  // "Detected Project Settings" wizard, which otherwise npm-installs wrangler into the
  // project and dies on the esbuild/vite peer-dependency conflict.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "void-main",
  "compatibility_date": "2026-10-19",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
